:root{
    --navy:#07152f;
    --blue:#1769e0;
    --blue2:#4d9cff;
    --light:#f4f7fc;
    --white:#ffffff;
    --text:#17233b;
    --muted:#718096;
    --border:#e5eaf2;
    --green:#16a36a;
    --red:#dc3545;
    --shadow:0 12px 35px rgba(20,42,80,.08);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Inter,Arial,sans-serif;
}

body{
    background:var(--light);
    color:var(--text);
}

/* LOGIN */

.login-page{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:
        radial-gradient(circle at 15% 20%,rgba(77,156,255,.25),transparent 30%),
        radial-gradient(circle at 85% 80%,rgba(23,105,224,.3),transparent 30%),
        linear-gradient(135deg,#04102b,#0b3471);
}

.login-card{
    width:100%;
    max-width:440px;
    background:rgba(255,255,255,.97);
    padding:40px;
    border-radius:28px;
    box-shadow:0 30px 80px rgba(0,0,0,.28);
}

.school-logo{
    width:85px;
    height:85px;
    border-radius:25px;
    margin:auto auto 20px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:white;
    font-size:30px;
    font-weight:900;
    background:linear-gradient(135deg,var(--blue),#072d70);
    box-shadow:0 12px 30px rgba(23,105,224,.35);
}

.login-card h1{
    text-align:center;
    font-size:27px;
    color:var(--navy);
}

.login-subtitle{
    text-align:center;
    color:var(--muted);
    margin:8px 0 28px;
}

.field{
    margin-bottom:17px;
}

.field label{
    display:block;
    font-size:13px;
    font-weight:700;
    margin-bottom:7px;
}

.field input,
.field select{
    width:100%;
    padding:14px 15px;
    border:1px solid var(--border);
    border-radius:12px;
    outline:none;
    background:#fafcff;
    font-size:14px;
}

.field input:focus,
.field select:focus{
    border-color:var(--blue);
    box-shadow:0 0 0 4px rgba(23,105,224,.1);
}

.login-btn{
    width:100%;
    padding:14px;
    border:0;
    border-radius:12px;
    color:white;
    background:linear-gradient(135deg,var(--blue),#07449e);
    font-weight:800;
    cursor:pointer;
    font-size:15px;
    transition:.2s;
}

.login-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 25px rgba(23,105,224,.3);
}

.demo{
    margin-top:18px;
    padding:12px;
    border-radius:12px;
    background:#eef5ff;
    color:#48617f;
    text-align:center;
    font-size:12px;
}

/* APP */

.app{
    display:none;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    position:fixed;
    width:265px;
    height:100vh;
    left:0;
    top:0;
    background:linear-gradient(180deg,#06142f,#09275a);
    color:white;
    padding:24px 16px;
    z-index:1000;
    overflow-y:auto;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
    padding:4px 10px 25px;
}

.brand-logo{
    width:45px;
    height:45px;
    border-radius:13px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#2384ff,#0a3d91);
    font-weight:900;
}

.brand strong{
    display:block;
    font-size:14px;
}

.brand span{
    display:block;
    color:#aebed8;
    font-size:11px;
    margin-top:3px;
}

.menu-title{
    color:#8095b8;
    font-size:10px;
    font-weight:bold;
    margin:14px 10px 8px;
    text-transform:uppercase;
}

.menu{
    list-style:none;
}

.menu button{
    width:100%;
    border:0;
    background:transparent;
    color:#d9e4f5;
    padding:12px 13px;
    margin:3px 0;
    border-radius:11px;
    text-align:left;
    cursor:pointer;
    font-size:13px;
    transition:.2s;
}

.menu button:hover,
.menu button.active{
    background:rgba(70,143,255,.2);
    color:white;
}

.menu button.active{
    box-shadow:inset 3px 0 0 #55a0ff;
}

.logout{
    margin-top:15px!important;
    color:#ffb4b9!important;
}

/* MAIN */

.main{
    margin-left:265px;
    min-height:100vh;
    padding:24px;
}

.mobile-bar{
    display:none;
}

.topbar{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:17px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:var(--shadow);
    margin-bottom:25px;
}

.welcome small{
    color:var(--muted);
}

.welcome strong{
    display:block;
    margin-top:4px;
    font-size:18px;
}

.account{
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:40px;
    height:40px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--blue),#0a3477);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:bold;
}

.account span{
    display:block;
}

.account small{
    color:var(--muted);
}

/* PAGE */

.page{
    display:none;
}

.page.active{
    display:block;
}

.heading{
    margin-bottom:20px;
}

.heading h2{
    font-size:25px;
    color:var(--navy);
}

.heading p{
    color:var(--muted);
    margin-top:5px;
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:17px;
    margin-bottom:20px;
}

.stat{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:20px;
    box-shadow:var(--shadow);
}

.stat-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.stat-icon{
    width:43px;
    height:43px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:12px;
    background:#edf5ff;
    font-size:20px;
}

.stat h3{
    font-size:27px;
    margin-top:15px;
}

.stat p{
    color:var(--muted);
    font-size:13px;
    margin-top:3px;
}

/* GRID */

.grid{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:20px;
}

.panel{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:20px;
    box-shadow:var(--shadow);
}

.panel-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:17px;
}

.panel-title h3{
    font-size:16px;
}

.panel-title span{
    color:var(--blue);
    font-size:12px;
}

/* ACTIVITY */

.activity{
    display:flex;
    gap:12px;
    padding:12px 0;
    border-bottom:1px solid var(--border);
}

.activity:last-child{
    border-bottom:0;
}

.activity-icon{
    width:36px;
    height:36px;
    border-radius:10px;
    background:#eef5ff;
    display:flex;
    align-items:center;
    justify-content:center;
}

.activity strong{
    font-size:13px;
}

.activity p{
    color:var(--muted);
    font-size:11px;
    margin-top:3px;
}

/* NOTICE */

.notice{
    padding:13px;
    background:#f5f8fd;
    border-radius:11px;
    margin-bottom:10px;
}

.notice strong{
    font-size:13px;
}

.notice p{
    color:var(--muted);
    font-size:11px;
    margin-top:5px;
}

/* TABLE */

.table-panel{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:20px;
    box-shadow:var(--shadow);
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:650px;
}

th{
    background:#f3f7fd;
    color:#3e5677;
    font-size:12px;
}

th,td{
    padding:13px;
    text-align:left;
    border-bottom:1px solid var(--border);
    font-size:13px;
}

td{
    color:#42526b;
}

.badge{
    padding:5px 9px;
    border-radius:20px;
    background:#e8f8ef;
    color:#148454;
    font-size:11px;
    font-weight:bold;
}

/* PROFILE */

.profile-card{
    background:white;
    border-radius:18px;
    padding:25px;
    box-shadow:var(--shadow);
}

.profile-header{
    display:flex;
    align-items:center;
    gap:18px;
    margin-bottom:25px;
}

.big-avatar{
    width:80px;
    height:80px;
    border-radius:22px;
    background:linear-gradient(135deg,var(--blue),#092e6e);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    font-weight:bold;
}

.profile-header h3{
    font-size:20px;
}

.profile-header p{
    color:var(--muted);
    margin-top:5px;
}

.info-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:14px;
}

.info{
    padding:15px;
    background:#f7f9fc;
    border-radius:12px;
}

.info label{
    display:block;
    color:var(--muted);
    font-size:11px;
    margin-bottom:5px;
}

.info strong{
    font-size:13px;
}

/* LINKS */

.link-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:17px;
}

.link-card{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:22px;
    box-shadow:var(--shadow);
}

.link-card .icon{
    font-size:28px;
    margin-bottom:15px;
}

.link-card h3{
    margin-bottom:7px;
}

.link-card p{
    color:var(--muted);
    font-size:12px;
    line-height:1.6;
}

.link-card a{
    display:inline-block;
    margin-top:15px;
    color:var(--blue);
    text-decoration:none;
    font-weight:bold;
    font-size:12px;
}

/* FOOTER */

footer{
    text-align:center;
    padding:35px 10px 15px;
    color:#8793a6;
    font-size:11px;
}

footer strong{
    color:#38577d;
}

/* MOBILE */

@media(max-width:1000px){

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .grid{
        grid-template-columns:1fr;
    }

    .link-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:760px){

    .sidebar{
        transform:translateX(-100%);
        transition:.25s;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .main{
        margin-left:0;
        padding:15px;
    }

    .mobile-bar{
        display:flex;
        align-items:center;
        justify-content:space-between;
        background:#07152f;
        color:white;
        margin:-15px -15px 15px;
        padding:13px 15px;
    }

    .mobile-bar button{
        border:0;
        background:transparent;
        color:white;
        font-size:23px;
        cursor:pointer;
    }
}

@media(max-width:550px){

    .stats{
        grid-template-columns:1fr;
    }

    .link-grid{
        grid-template-columns:1fr;
    }

    .topbar{
        align-items:flex-start;
    }

    .account{
        margin-top:10px;
    }

    .info-grid{
        grid-template-columns:1fr;
    }

    .login-card{
        padding:28px 22px;
    }
}
</style>
</head>

